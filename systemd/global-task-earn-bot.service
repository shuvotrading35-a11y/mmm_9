[Unit]
Description=Global Task Earn — Telegram Bot
After=network.target postgresql.service redis.service
Requires=postgresql.service redis.service

[Service]
Type=simple
User=gte
Group=gte
WorkingDirectory=/opt/global_task_earn
EnvironmentFile=/opt/global_task_earn/.env
ExecStartPre=/opt/global_task_earn/venv/bin/alembic upgrade head
ExecStart=/opt/global_task_earn/venv/bin/python bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gte-bot

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/global_task_earn/logs

[Install]
WantedBy=multi-user.target
