# ── Bot ──────────────────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
BOT_USERNAME=YourBotUsername

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://gte_user:gte_pass@localhost:5432/global_task_earn

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs with full admin access
ADMIN_IDS=123456789,987654321
SUPPORT_USERNAME=@your_support_handle

# ── Blockchain (BSC) ─────────────────────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org/
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
PAYOUT_WALLET_ADDRESS=0xYourPayoutWalletAddress
# ⚠️ NEVER commit this to git. Use secrets manager in production.
PAYOUT_PRIVATE_KEY=

# ── Financial Limits ─────────────────────────────────────────────────────────
MIN_WITHDRAWAL=0.12
MAX_WITHDRAWAL=100.00
REFERRAL_REWARD=0.010
REFERRAL_COMMISSION_PCT=10
SPONSOR_MIN_DEPOSIT=1.00
TASK_MIN_REWARD=0.001
TASK_MAX_REWARD=1.000
MIN_DEPOSIT_CONFIRMATIONS=12

# ── Security ─────────────────────────────────────────────────────────────────
# Random secret used for idempotency key generation. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_SALT=

# ── Features ─────────────────────────────────────────────────────────────────
AUTO_PAYOUT_ENABLED=true
MAINTENANCE_MODE=false
FORCE_JOIN_ENABLED=true
FRAUD_AUTO_BAN_SCORE=76
FRAUD_RESTRICT_SCORE=51
FRAUD_FLAG_SCORE=26

# ── Webhook (leave blank for polling mode) ───────────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=8443

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Rate Limits ──────────────────────────────────────────────────────────────
RATE_TASK_VERIFY_LIMIT=5
RATE_TASK_VERIFY_WINDOW=30
RATE_WITHDRAW_LIMIT=3
RATE_WITHDRAW_WINDOW=3600
RATE_SUPPORT_LIMIT=2
RATE_SUPPORT_WINDOW=3600
RATE_START_LIMIT=10
RATE_START_WINDOW=60
